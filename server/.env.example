PORT=5080
# Local MongoDB, or an Atlas mongodb+srv:// URI
MONGO_URI=mongodb://127.0.0.1:27017/trip-war-room
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5180
# Optional: set if Atlas fails with "querySrv ECONNREFUSED" (common on Windows)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# AI Concierge (optional). Without a key the Concierge still works and gives
# accurate, rule-checked answers from a fixed template; with a key, Claude
# writes the wording. Get a key at https://platform.claude.com
# ANTHROPIC_API_KEY=
# CONCIERGE_MODEL=claude-opus-5-5
# CONCIERGE_EFFORT=low              # low | medium | high
# CONCIERGE_TIMEOUT_MS=2500         # slower replies fall back to the template
# CONCIERGE_RATE_LIMIT=20           # questions per traveller per minute
# VOTE_SECONDS=120                  # default length of a contested-slot vote

# Optional tuning (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900     # max 3600
# REFRESH_TOKEN_TTL_DAYS=7
# PRESENCE_GRACE_MS=5000           # how long a dropped traveller has to reconnect silently
# FLUSH_INTERVAL_MS=250            # how often batched board moves are saved
# LOG_LEVEL=info                   # debug | info | warn | error | silent
